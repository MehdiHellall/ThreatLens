# Local model artifact.
EMAIL_THREAT_MODEL_PATH=artifacts/tfidf_logreg.joblib
EMAIL_THREAT_MODEL_SHA256=d9ed306935e26c9bf7b285a861991bb3539be7089ad9d8bf798d781d01d45981

# Remote model artifact. Requires a SHA-256 checksum.
# EMAIL_THREAT_MODEL_URL=https://example.com/models/tfidf_logreg.joblib
# Replace EMAIL_THREAT_MODEL_SHA256 with the remote artifact's trusted digest.
# EMAIL_THREAT_MODEL_CACHE_PATH=/var/cache/threatlens/model.joblib
EMAIL_THREAT_MODEL_RETRY_SECONDS=30
EMAIL_THREAT_MAX_ARTIFACT_BYTES=1073741824

# Fine-tuned DistilBERT artifact. This is the primary model used by the app.
# Use either a local directory or an HTTPS ZIP, never both. If the artifact is
# missing, the app reports that clearly and falls back to the TF-IDF baseline.
# To use the remote ZIP instead, set this to an explicitly empty value.
EMAIL_THREAT_DISTILBERT_MODEL_PATH=artifacts/distilbert
# EMAIL_THREAT_DISTILBERT_MODEL_URL=https://example.com/models/threatlens-distilbert-<sha256>.zip
# EMAIL_THREAT_DISTILBERT_MODEL_SHA256=<64-lowercase-hex-characters>
EMAIL_THREAT_DISTILBERT_MODEL_CACHE_PATH=/var/cache/threatlens/distilbert
EMAIL_THREAT_DISTILBERT_MAX_LENGTH=128

# Runtime controls.
EMAIL_THREAT_BACKGROUND_WARMUP=true
EMAIL_THREAT_RATE_LIMIT_PER_MINUTE=60
EMAIL_THREAT_MAX_BODY_BYTES=16384
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2

# API CORS.
EMAIL_THREAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
